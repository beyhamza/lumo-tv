# Lumo TV — production environment (S16B-01). Copy to deploy/.env on the VPS,
# fill in every empty value, and never commit the copy (.gitignore ignores it).
# Generate each secret on the server, for instance: openssl rand -base64 48

# --- Optional services -----------------------------------------------------------
# smtp4dev catches the API's email until a real provider exists (see Mail below).
# Add `bench` to start the source test bench too: smtp4dev,bench
COMPOSE_PROFILES=smtp4dev

# --- Names (their DNS records must point at the VPS before the first start) --
LUMO_API_DOMAIN=api.lumo-tv.com
LUMO_WEB_DOMAIN=lumo-tv.com
# Only with the `bench` profile and caddy.d/bench.caddy.
LUMO_BENCH_DOMAIN=bench.lumo-tv.com
# Let's Encrypt account address (expiry notices).
LUMO_ACME_EMAIL=
# Empty in production. `local_certs` for a trial run on a workstation.
LUMO_CADDY_GLOBAL=

# --- Images (built by .github/workflows/images.yml) ---------------------------
# Tag pulled for lumo-api and lumo-web: the version without its `v`. The site
# shows the version it was built with, so a published image and this value agree.
LUMO_VERSION=0.4.0
# Registry and owner. A private package needs `docker login ghcr.io` once on the
# server, with a token limited to read:packages (docs/ops/deploy-vps.md).
LUMO_IMAGE_PREFIX=ghcr.io/beyhamza

# --- Database ------------------------------------------------------------------
POSTGRES_DB=lumo
POSTGRES_USER=lumo
# Read on the very first start only (it initialises the data directory).
POSTGRES_PASSWORD=
LUMO_BACKUP_KEEP_DAYS=14

# --- State on the host -----------------------------------------------------------
# Absolute path, outside the git clone: `git clean` must never reach it. Holds
# postgres/ (the database), caddy/ (the TLS certificates), smtp4dev/ and logs/.
LUMO_DATA_DIR=/srv/lumo
# Days of logs kept in logs/<service>/.
LUMO_LOG_KEEP_DAYS=14

# --- API secrets -----------------------------------------------------------------
# Losing LUMO_ENCRYPTION_MASTER_KEY makes every stored provider password
# unreadable: keep a copy outside the VPS.
LUMO_JWT_SECRET=
LUMO_ENCRYPTION_MASTER_KEY=

# --- Web secret -------------------------------------------------------------------
SESSION_SECRET=

# --- Mail (address verification, password reset) -----------------------------------
# The smtp4dev service of the compose file: no login and no TLS, on the private
# network only. With a real provider: its host, port 587, its credentials, both
# flags to true, and smtp4dev out of COMPOSE_PROFILES.
SPRING_MAIL_HOST=smtp4dev
SPRING_MAIL_PORT=25
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_STARTTLS=false
LUMO_MAIL_FROM=no-reply@lumo-tv.com
# Port of the smtp4dev inbox on the server's loopback, for an SSH tunnel.
LUMO_SMTP4DEV_PORT=5080

# Ports on the host. 80 and 443 in production; anything free for a trial run.
LUMO_HTTP_PORT=80
LUMO_HTTPS_PORT=443
