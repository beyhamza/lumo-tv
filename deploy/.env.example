# Lumo TV — production environment (S16B-01). Copy to deploy/.env on the VPS,
# fill in every value, and never commit the copy (.gitignore ignores it).
# Generate each secret on the server, for instance: openssl rand -base64 48

# --- Names (their DNS records must point at the VPS before the first start) --
LUMO_API_DOMAIN=api.example.test
LUMO_WEB_DOMAIN=example.test
# Only with the `bench` profile and caddy.d/bench.caddy.
LUMO_BENCH_DOMAIN=bench.example.test
# Let's Encrypt account address (expiry notices).
LUMO_ACME_EMAIL=ops@example.test
# Empty in production. `local_certs` for a trial run on a workstation.
LUMO_CADDY_GLOBAL=

# --- Images (built by .github/workflows/images.yml) ---------------------------
# Tag pulled for lumo-api and lumo-web: the version without its `v`. The site
# shows the version it was built with, so a published image and this value agree.
LUMO_VERSION=0.4.0
# Registry and owner. A private package needs `docker login ghcr.io` once on the
# server, with a token limited to read:packages (docs/ops/deploy-vps.md).
LUMO_IMAGE_PREFIX=ghcr.io/beyhamza

# --- Database ------------------------------------------------------------------
POSTGRES_DB=lumo
POSTGRES_USER=lumo
# Read on the very first start only (it initialises the volume).
POSTGRES_PASSWORD=
LUMO_BACKUP_KEEP_DAYS=14

# --- API secrets -----------------------------------------------------------------
# Losing LUMO_ENCRYPTION_MASTER_KEY makes every stored provider password
# unreadable: keep a copy outside the VPS.
LUMO_JWT_SECRET=
LUMO_ENCRYPTION_MASTER_KEY=

# --- Web secret -------------------------------------------------------------------
SESSION_SECRET=

# --- Mail (address verification, password reset) -----------------------------------
SPRING_MAIL_HOST=smtp.example.test
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
LUMO_MAIL_FROM=no-reply@example.test

# Ports on the host. 80 and 443 in production; anything free for a trial run.
LUMO_HTTP_PORT=80
LUMO_HTTPS_PORT=443
