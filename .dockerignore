# Build context for apps/api/Dockerfile, which is rooted here.
# Keep it small, and free of anything secret.

.git/
.github/
**/.env
**/.env.*
!**/.env.example
**/build/
**/.gradle/
**/node_modules/
**/.next/
**/.idea/
**/*.iml
**/*.log
apps/web/
apps/android/
docs/

# Local container state (docker-compose bind-mounts ./docker-data/postgres).
# Never part of an image build, and several hundred megabytes of it.
docker-data/
