# ==============================================================================
# lumo.tv (apps/web) — environment template.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Next.js loads .env.local automatically; it is gitignored and must never be
# committed (AGENTS.md §5).
#
# NEXT_PUBLIC_ IS NOT A NAMING CONVENTION, IT IS A PUBLICATION.
# Any variable with that prefix is inlined into the JavaScript bundle at build
# time and is readable by anyone who opens the page. Never give that prefix to a
# secret key, a webhook secret or a database credential.
# ==============================================================================

# ---- API ---------------------------------------------------------------------

# Base URL of lumo-api, as reached from the BROWSER. Public by necessity: the
# client-side openapi-fetch calls go here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1

# Base URL of lumo-api, as reached from the Next.js SERVER (Server Components,
# Route Handlers). Identical in local development; differs in a deployment where
# the API is reachable on an internal network the browser cannot see.
API_BASE_URL=http://localhost:8080/v1

# Public origin of the site itself. Used for canonical URLs, sitemap, Open Graph
# tags and the redirect target of the /activate flow.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---- Sessions ----------------------------------------------------------------

# Key encrypting the httpOnly session cookie that holds the refresh token.
# At least 32 characters:
#   openssl rand -base64 32
# The refresh token never reaches client-side JavaScript: cookies are httpOnly
# and SameSite=Lax (docs/architecture.md §5).
SESSION_SECRET=

# Name of the session cookie.
SESSION_COOKIE_NAME=lumo_session

# Set to true only behind HTTPS. It must stay false on plain http://localhost or
# the browser silently drops the cookie and every sign-in appears to succeed and
# then do nothing.
SESSION_COOKIE_SECURE=false


# ---- Google Sign-In (US-03) --------------------------------------------------

# OAuth client ID for the browser sign-in button. Public by design: a client ID
# is not a secret. The matching client SECRET does not belong in this
# application — the backend verifies the id_token on its own.
#
# EMPTY IS A SUPPORTED STATE, and the one in a fresh checkout: no button is
# drawn, and Google's script is never even fetched. A button certain to fail
# teaches a visitor that the site is broken; the email form is complete alone.
#
# The console needs two things for this to work, and the second is the one that
# is easy to miss:
#
#   - Authorised JavaScript origin:  http://localhost:3000  (your site's origin)
#   - Authorised redirect URI:       http://localhost:3000/api/auth/google
#
# The redirect URI is required because this application uses `ux_mode:
# "redirect"`, where Google POSTs the ID token straight to that endpoint instead
# of handing it to our JavaScript. Registering only the origin gives a
# "redirect_uri_mismatch" at the moment somebody picks their account.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ---- Internationalisation ----------------------------------------------------

# There is no variable here, and that is on purpose.
#
# The locales are declared in src/i18n/routing.ts, through next-intl's
# defineRouting(). That single declaration is what generates the static params
# for every marketing page, what the proxy matches a URL prefix against, and
# what the `Locale` type is derived from - so a locale added by environment
# variable would produce URLs no page is built for and a type that does not know
# it exists. Two variables used to be documented here as if they governed it;
# nothing read them.
#
# Adding a language: extend `locales` in src/i18n/routing.ts, add
# src/messages/<code>.json, and run the tests - messages.test.ts fails on a key
# present in one language and missing from another.


# ---- Billing: Stripe (ADR 0003) ----------------------------------------------
#
# Nothing reads these two yet: the checkout story is not built, and the
# subscription page reads GET /me/entitlement rather than anything Stripe says.
# They are listed because ADR 0003 fixes the shape of that story, not because
# leaving them empty breaks anything today.

# Publishable key for Stripe Checkout redirection. Publishable, as the name says.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price identifier of the premium subscription, used to open a Checkout session.
STRIPE_PREMIUM_PRICE_ID=


# ---- Build and test ----------------------------------------------------------

# Base URL Playwright drives during end-to-end tests.
#
# Nothing needs to be set here. The suite serves its own production build on
# 3100, and brings PostgreSQL and lumo-api up on 55432 and 18080 - ports chosen
# so a run cannot collide with, or worse silently reuse, a development stack
# you already have on 5432/8080/3000. See apps/web/e2e/support/stack.ts.
#
# Its secrets are generated per run and never written to a file, so there is no
# .env for the end-to-end environment and there should never be one.
PLAYWRIGHT_BASE_URL=http://localhost:3100

# Set to 1 to skip Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
