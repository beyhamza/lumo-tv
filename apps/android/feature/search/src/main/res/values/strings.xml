<?xml version="1.0" encoding="utf-8"?>
<!--
  English strings for feature:search. The French set lives in values-fr and ships
  at the same time (AGENTS.md §4); lint fails the build on a missing translation.
-->
<resources>
    <string name="feature_search_title">Search</string>
    <!-- The invitation shown while the field is empty. S10-04 finishes this state;
         S10-02 only has to say something honest and load nothing. -->
    <string name="feature_search_invitation">Search your channels, films and series.</string>
    <string name="feature_search_hint">Channels, films, series</string>
    <string name="feature_search_clear">Clear the search</string>
    <string name="feature_search_glyph_search" translatable="false">⌕</string>
    <string name="feature_search_glyph_clear" translatable="false">✕</string>
    <!-- The television's explicit way from the field to the first result (Q9):
         the D-pad activates it, and it keeps the focus while a request is in
         flight rather than moving somebody mid-keystroke. -->
    <string name="feature_search_see_results">See results</string>
    <!--
      The query is longer than the contract's q allows. The text is refused, never
      shortened silently (Q9, SR-05); this says so next to the field.
    -->
    <string name="feature_search_too_long">Searching is limited to 100 characters.</string>

    <!-- The four filters. Only the ones the source carries are offered (SR-11). -->
    <string name="feature_search_filter_all">All</string>
    <string name="feature_search_filter_channels">Channels</string>
    <string name="feature_search_filter_films">Films</string>
    <string name="feature_search_filter_series">Series</string>

    <string name="feature_search_see_all">See all</string>
    <string name="feature_search_show_more">Show more</string>
    <string name="feature_search_loading">Searching…</string>
    <string name="feature_search_empty">No result for “%1$s”.</string>
    <string name="feature_search_error">The search did not complete.</string>
    <string name="feature_search_page_error">The next page did not load.</string>
    <string name="feature_search_retry">Try again</string>
</resources>
