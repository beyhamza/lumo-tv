<?xml version="1.0" encoding="utf-8"?>
<!--
  English strings for feature:source. The French set lives in values-fr and ships
  at the same time (AGENTS.md §4); lint fails the build on a missing translation.

  The wording is the site's, deliberately. The same person may register a source
  on lumo.tv and then open the phone; two different explanations of what an M3U
  is would read as two different products.
-->
<resources>
    <string name="feature_source_title">Source</string>
    <string name="feature_source_placeholder">Register an M3U playlist or Xtream Codes credentials.</string>

    <string name="feature_source_add_title">Add a source</string>
    <!-- Says what Lumo is, once, where it matters most (AGENTS.md §1). -->
    <string name="feature_source_add_subtitle">An M3U playlist or Xtream Codes credentials. Lumo provides no content: you bring your own.</string>

    <string name="feature_source_kind_legend">Kind of source</string>
    <string name="feature_source_kind_m3u">M3U playlist</string>
    <string name="feature_source_kind_m3u_hint">An address that returns a playlist file.</string>
    <string name="feature_source_kind_xtream">Xtream Codes</string>
    <string name="feature_source_kind_xtream_hint">A panel\'s credentials. Better experience: categories, guide and account details.</string>
    <string name="feature_source_change_kind">Choose a different kind</string>

    <string name="feature_source_label_label">Name</string>
    <string name="feature_source_label_hint">So you can tell them apart if you register several.</string>
    <string name="feature_source_playlist_label">Playlist address</string>
    <string name="feature_source_playlist_hint">The full address, exactly as your provider gave it to you.</string>
    <string name="feature_source_host_label">Server address</string>
    <!--
      Says out loud that the address is normalised server-side, so nobody hunts
      for the "right" form of it (US-06).
    -->
    <string name="feature_source_host_hint">With or without http://, with or without a port. The address is normalised for you.</string>
    <string name="feature_source_username_label">Username</string>
    <string name="feature_source_password_label">Password</string>
    <string name="feature_source_password_hint">Encrypted before it is stored. It is never shown again, not even to you.</string>
    <string name="feature_source_epg_label">Programme guide (optional)</string>
    <string name="feature_source_epg_hint">An XMLTV address, if your provider offers a separate one.</string>

    <string name="feature_source_submit">Save source</string>
    <!-- Not "Saving": the server contacts the provider before it answers. -->
    <string name="feature_source_submitting">Checking…</string>

    <string name="feature_source_syncing_title">Importing</string>
    <!--
      The step labels themselves, and the sentence for each ingestion code, moved
      down to core:data with the home screen (US-017), which says the same things
      about the same source. See core/data/src/main/res/values/strings.xml.
    -->

    <string name="feature_source_ready_title">Source ready</string>
    <string name="feature_source_counts">%1$d channels · %2$d categories</string>
    <string name="feature_source_expires_on">Subscription valid until %1$s</string>
    <string name="feature_source_max_connections">%1$d simultaneous stream(s) allowed</string>

    <string name="feature_source_error_title">The import failed</string>
    <!-- Only the format failure needs this: it is the one the user cannot correct without knowing what a right answer looks like. -->
    <string name="feature_source_error_invalid_format_help">An M3U address usually ends in .m3u or .m3u8, or contains get.php. A page you can open in a browser is usually not one.</string>
    <string name="feature_source_fix_credentials">Correct my credentials</string>
    <string name="feature_source_fix_address">Correct the address</string>
    <string name="feature_source_retry">Try again</string>
    <string name="feature_source_syncing_body">A large playlist can take up to a minute.</string>

    <!--
      The ceiling comes from `GET /me/entitlement` and is explained without a
      way to pay for a higher one: the 0.2.0 scope is a free version (US-025,
      decision of 17 September 2026). What the sentence offers is the one thing
      the user can do.
    -->
    <string name="feature_source_limit_title">This account can hold %1$d source(s)</string>
    <string name="feature_source_limit_body">Remove one to add another.</string>

    <!--
      What is left here is what only the add-source form can meet. One message per
      code, never a generic fallback: the contract says no client may collapse them.
    -->
    <string name="feature_source_error_limit">This account cannot hold one more source. Remove one to add another.</string>
    <string name="feature_source_error_validation">Some of the information is incorrect.</string>
    <string name="feature_source_error_offline">No connection. Nothing was sent.</string>
    <!-- "Too many attempts" is the same wait as a refresh asked too soon: see feature_source_list_refresh_wait. -->

    <!--
      "My sources" (US-024, design S8-E05 to E08): the list of the account's
      sources, and what can be done to each. Shared by the phone and the
      television; what only the television says is in strings_tv.xml.
    -->
    <string name="feature_source_list_title">My sources</string>
    <string name="feature_source_list_subtitle">The sources of your account, what they hold and what they are doing.</string>
    <string name="feature_source_kind_m3u_short" translatable="false">M3U</string>
    <string name="feature_source_kind_xtream_short" translatable="false">Xtream</string>
    <!-- The source this device browses. In words, not only as a colour. -->
    <string name="feature_source_list_active">In use on this device</string>
    <string name="feature_source_list_last_synced">Refreshed %1$s</string>
    <string name="feature_source_list_never_synced">Never refreshed successfully</string>
    <string name="feature_source_list_failed_at">Last attempt %1$s.</string>
    <!--
      Counts, only when known: an unknown number is a line that is not drawn,
      never a zero. No series count exists for an M3U source (adr/0010).
    -->
    <plurals name="feature_source_list_channels">
        <item quantity="one">%1$d channel</item>
        <item quantity="other">%1$d channels</item>
    </plurals>
    <plurals name="feature_source_list_films">
        <item quantity="one">%1$d film</item>
        <item quantity="other">%1$d films</item>
    </plurals>
    <plurals name="feature_source_list_series">
        <item quantity="one">%1$d series</item>
        <item quantity="other">%1$d series</item>
    </plurals>

    <string name="feature_source_list_use">Use this source</string>
    <string name="feature_source_list_refresh">Refresh</string>
    <!-- The control while a synchronisation runs: it says so and takes no press. -->
    <string name="feature_source_list_refreshing">Refreshing…</string>
    <string name="feature_source_list_rename">Rename</string>
    <string name="feature_source_list_delete">Delete</string>

    <!--
      429 SOURCE_SYNC_RATE_LIMITED. The delay is the server's Retry-After, rounded
      up to whole minutes. Without a readable header there is no number: a
      duration is never invented.
    -->
    <plurals name="feature_source_list_refresh_wait_minutes">
        <item quantity="one">Too soon. Again in about %1$d min.</item>
        <item quantity="other">Too soon. Again in about %1$d min.</item>
    </plurals>
    <string name="feature_source_list_refresh_wait">Too soon. Try again a little later.</string>
    <string name="feature_source_list_refresh_failed">The refresh could not be started. Your source is unchanged.</string>
    <string name="feature_source_list_refresh_offline">No connection. The refresh was not started.</string>

    <string name="feature_source_list_auto_sync">Automatic refresh</string>
    <!-- The surprise worth saying: the switch is on a phone, the setting is the account's. -->
    <string name="feature_source_list_auto_sync_hint">Applies to this source on your whole account: the website and your TV follow it too.</string>
    <string name="feature_source_list_auto_sync_failed">This setting could not be saved. It is back to what it was.</string>

    <string name="feature_source_list_unavailable_title">Your sources could not be read</string>
    <string name="feature_source_list_unavailable_body">Lumo could not be reached. Nothing has changed on your account: check your connection, then try again.</string>

    <string name="feature_source_rename_title">Rename this source</string>
    <string name="feature_source_rename_hint">Only the name changes. The catalogue is not imported again.</string>
    <string name="feature_source_rename_failed">This name could not be saved. Try again.</string>
    <string name="feature_source_rename_save">Save</string>
    <string name="feature_source_dialog_cancel">Cancel</string>

    <!--
      The confirmation US-024 asks for, sentence by sentence. The watchlist joins
      the first one with its own lot (sprint 11) and is not mentioned before.
    -->
    <string name="feature_source_delete_title">Delete “%1$s”?</string>
    <string name="feature_source_delete_removed">Its catalogue, its favourites, your playback progress and its recently watched channels will be removed from Lumo.</string>
    <string name="feature_source_delete_kept">Your other sources and their data are kept.</string>
    <string name="feature_source_delete_subscription">This does not cancel your subscription with your provider.</string>
    <string name="feature_source_delete_no_restore">Adding this source again will not bring the deleted data back.</string>
    <string name="feature_source_delete_confirm">Delete this source</string>
    <string name="feature_source_delete_deleting">Deleting…</string>
    <string name="feature_source_delete_failed">The source could not be deleted. Nothing has changed.</string>
    <string name="feature_source_delete_offline">No connection. The source was not deleted and nothing has changed.</string>

    <!-- After adding (US-024): the flow's own titles and ways on. -->
    <string name="feature_source_watch_title">Your source</string>
    <string name="feature_source_fix_title">Correct this source</string>
    <string name="feature_source_syncing_leave">You can leave this screen: the import goes on, and My sources shows where it is.</string>
    <string name="feature_source_discover">Discover my catalogue</string>
    <string name="feature_source_back_to_list">Back to My sources</string>

    <!--
      The source switcher of both shells (US-018, design S8-E04). "Source" sits
      next to the name of the one being browsed, always; the rest is the list
      that opens when there are several.
    -->
    <string name="feature_source_switcher_label">Source</string>
    <string name="feature_source_switcher_change">Change source</string>
    <!-- Said in the list: what is chosen here does not follow the account. -->
    <string name="feature_source_switcher_device_only">This choice applies to this device only.</string>
    <!--
      Several sources and none chosen on this device: the list is required, and
      nothing in it is preselected.
    -->
    <string name="feature_source_switcher_choose_title">Choose a source</string>
    <string name="feature_source_switcher_choose_body">You have several sources. Choose the one to browse on this device. You can change it at any time.</string>
    <string name="feature_source_switcher_status_ready">Ready</string>
    <string name="feature_source_switcher_status_refreshing">Refreshing</string>
    <string name="feature_source_switcher_status_error">Error</string>
    <string name="feature_source_switcher_manage">My sources</string>
</resources>
