<?xml version="1.0" encoding="utf-8"?>
<!--
  "My sources" on the television (US-024, design S8-E09). What the list itself
  says — names of states, counts, the refresh sentences — is shared with the
  phone and lives in strings.xml; this file is what only a television says.
-->
<resources>
    <string name="feature_source_tv_loading">Reading your sources…</string>
    <!-- The one thing a television with no source can do: look again. -->
    <string name="feature_source_tv_check_again">Check again</string>

    <!-- Credentials and addresses are corrected where they can be typed. -->
    <string name="feature_source_tv_error_hint">Correct it from the phone app or lumo.tv.</string>

    <!--
      Where the rest is done. Not the activation wording, on purpose: pairing a
      television is about the account, and whoever reads this is signed in.
    -->
    <string name="feature_source_tv_guidance_title">Add, rename or delete a source</string>
    <string name="feature_source_tv_guidance_body">From the phone app or lumo.tv — that is also where automatic refresh is turned on or off. Changes appear here by themselves.</string>
</resources>
