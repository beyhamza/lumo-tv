<?xml version="1.0" encoding="utf-8"?>
<!--
  English strings for feature:live. The French set lives in values-fr and ships
  at the same time (AGENTS.md §4); lint fails the build on a missing translation.
-->
<resources>
    <string name="feature_live_title">Live TV</string>
    <string name="feature_live_placeholder">Your channels will appear here once a source has finished syncing.</string>

    <string name="feature_live_no_source_title">No channels yet</string>
    <string name="feature_live_no_source_body">Register an M3U playlist or an Xtream Codes account from the Source tab, and your channels will appear here.</string>

    <!--
      Distinct from "no channels": a source that is still importing is a wait,
      and an empty list would read as a source that holds nothing.
    -->
    <string name="feature_live_not_ready_title">Your source is not ready</string>
    <string name="feature_live_not_ready_body">The import has not finished, or it failed. The Source tab says where it got to.</string>

    <string name="feature_live_all_categories">All</string>
    <string name="feature_live_category_count">%1$s (%2$d)</string>

    <!--
      Discreet on purpose (US-08). The list works offline, so this is a normal
      state rather than a failure — but a catalogue silently a week old is the
      failure nobody can diagnose, so it is said.
    -->
    <string name="feature_live_tv_loading">Loading your channels…</string>
    <string name="feature_live_tv_unknown_channel">This channel</string>
    <string name="feature_live_tv_back_hint">Press BACK to return to your channels.</string>
    <string name="feature_live_offline">From your device</string>
    <string name="feature_live_refresh">Refresh</string>
    <string name="feature_live_refresh_failed">Could not reach the server. The list below is the one already on your device.</string>

    <!-- Watching a channel (US-09). Never a silent black rectangle. -->
    <string name="feature_live_player_retry">Try again</string>
    <string name="feature_live_player_back">Back to the channels</string>
    <string name="feature_live_player_unreachable">This channel could not be reached. Your provider may be down, or the connection dropped.</string>
    <!--
      Names whose limit it is. The ceiling belongs to the subscription the user
      pays for, and a message that does not say so turns their provider's rule
      into our fault.
    -->
    <string name="feature_live_player_too_many_streams">Your subscription is already streaming as much as it allows. Stop another device, then try again.</string>
    <string name="feature_live_player_too_many_streams_count">Your subscription allows %1$d simultaneous stream(s), and they are all in use. Stop another device, then try again.</string>
    <string name="feature_live_player_not_ready">This source has not finished importing. The Source tab says where it got to.</string>
    <string name="feature_live_player_expired">Your subscription with this provider has expired. Lumo cannot renew it.</string>
    <string name="feature_live_player_channel_gone">This channel is no longer in your playlist. Refresh the list to see what is.</string>
    <string name="feature_live_player_unplayable">This device cannot decode this stream.</string>
    <string name="feature_live_player_unexpected">Playback stopped. Please try again.</string>

    <!--
      Favourites (US-12). The heart is described by what a tap does, not by what
      is drawn: TalkBack reading "heart" says nothing about whether the channel is
      starred.
    -->
    <string name="feature_live_favorite_add">Add to favourites</string>
    <string name="feature_live_favorite_remove">Choose favourite groups</string>
    <string name="feature_live_favorite_new_group">New group</string>
    <string name="feature_live_favorite_group_name">Group name</string>
    <string name="feature_live_favorite_group_create">Create</string>
    <!--
      Shown in place of the name the server gives the group it creates on the first
      add, and only while that name is still the server&apos;s own. Once the user has
      renamed the group, their name wins.
    -->
    <string name="feature_live_favorite_default_group">Favourites</string>
    <string name="feature_live_favorite_failed">That change could not be saved. Check your connection and try again.</string>

    <!--
      The long-press label on a television card (S4-07). Read by an accessibility
      service; it says what holding OK does, since nothing on the card can.
    -->
    <string name="feature_live_tv_favorite_hint">Hold OK to choose favourite groups</string>
</resources>
