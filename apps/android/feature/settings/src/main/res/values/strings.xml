<?xml version="1.0" encoding="utf-8"?>
<!--
  English strings for feature:settings, shared by both surfaces. The French set
  lives in values-fr and ships at the same time (AGENTS.md §4); lint fails the
  build on a missing translation. Phone-only wording is in strings_mobile.xml,
  television-only wording in strings_tv.xml.
-->
<resources>
    <string name="feature_settings_title">Settings</string>
    <string name="feature_settings_session_open">Signed in on this device.</string>
    <string name="feature_settings_session_none">Not signed in on this device.</string>

    <!--
      Signing out is behind a confirmation since S8-06 (US-025), Cancel being the
      default. The body says what happens and what does not: nothing about the
      account, the catalogue or the progress is removed by leaving a device.
    -->
    <string name="feature_settings_sign_out">Sign out of this device</string>
    <string name="feature_settings_sign_out_title">Sign out of this device?</string>
    <string name="feature_settings_sign_out_body">You will have to sign in again to find your sources here. Nothing is removed from your account.</string>
    <string name="feature_settings_cancel">Cancel</string>

    <!--
      Devices (US-025). `is_current` and `last_seen_at` are the server's: the
      screen marks the row it is told to, and prints a last activity — never
      "online", which nothing announces.
    -->
    <string name="feature_settings_this_device">This device</string>
    <string name="feature_settings_last_seen">Last activity %1$s</string>
    <string name="feature_settings_last_seen_unknown">Last activity unavailable</string>
    <!-- The platform, for a device that has neither a name nor a model. -->
    <string name="feature_settings_platform_android_mobile">Android phone or tablet</string>
    <string name="feature_settings_platform_android_tv">Android TV</string>
    <string name="feature_settings_platform_web">Web browser</string>
    <string name="feature_settings_devices_loading">Reading your devices…</string>
    <!-- A list that failed to load is not an empty one: it offers a retry. -->
    <string name="feature_settings_devices_unavailable">Your devices could not be read.</string>
    <string name="feature_settings_devices_retry">Try again</string>

    <!-- Application: the interface language, chosen in Lumo since S13-04. -->
    <string name="feature_settings_language">Language</string>

    <!-- Help and information: the guides on the website, and the installed version. -->
    <string name="feature_settings_guides">Guides</string>
    <string name="feature_settings_version">Version</string>
    <string name="feature_settings_unknown_value" translatable="false">—</string>

    <!-- S13-03/05: next episode and mobile data, in Playback. -->
    <string name="feature_settings_autoplay_next">Next episode automatically</string>
    <string name="feature_settings_autoplay_next_note">On this device. Off: the next episode is offered without a countdown.</string>
    <string name="feature_settings_floating_window">Floating window when leaving the app</string>
    <string name="feature_settings_floating_window_note">On this device. Off: leaving the app pauses playback.</string>
    <string name="feature_settings_mobile_data">Playback on mobile data</string>
    <string name="feature_settings_mobile_data_note">Off: playback on Wi-Fi only. The catalogue stays available.</string>
    <string name="feature_settings_on">On</string>
    <string name="feature_settings_off">Off</string>
    <string name="feature_settings_playback_not_saved">This setting could not be saved on this device.</string>

    <!--
      S13-04: the five sections of US-025, in the website's order, on both
      surfaces — the phone's list and the television's menu.
    -->
    <string name="feature_settings_menu_account">Account and devices</string>
    <string name="feature_settings_menu_sources">My sources</string>
    <string name="feature_settings_menu_playback">Playback</string>
    <string name="feature_settings_menu_application">Application</string>
    <string name="feature_settings_menu_about">Help and information</string>
    <string name="feature_settings_back">Back to Settings</string>
    <string name="feature_settings_back_label">‹ Settings</string>
    <string name="feature_settings_version_value">Version %1$s</string>

    <!-- Playback (S13-E05): the store the player opens streams with. -->
    <string name="feature_settings_playback_scope">For this account on this device. Nothing changes on your other devices.</string>
    <string name="feature_settings_audio_language">Preferred audio language</string>
    <string name="feature_settings_audio_language_note">When a programme does not have it, its default track plays; your preference stays.</string>
    <string name="feature_settings_subtitles">Show subtitles</string>
    <string name="feature_settings_subtitle_language">Subtitle language</string>
    <string name="feature_settings_subtitle_language_note">When a programme does not have it, no subtitles in another language are turned on. Kept while subtitles are off.</string>
    <string name="feature_settings_language_not_set">Not set</string>
    <string name="feature_settings_quality_note">Quality is chosen in the player and applies to the current playback only.</string>

    <!-- Application (S13-E08): the interface language, each named in itself. -->
    <string name="feature_settings_language_current">Current language</string>
    <string name="feature_settings_language_note">Applies to Lumo on this device. It does not change your account, your other devices or the playback languages.</string>

    <!-- Deleting the account (S16B-02): password-confirmed, irreversible. -->
    <string name="feature_settings_delete_account">Delete my account</string>
    <string name="feature_settings_delete_title">Permanently delete your account?</string>
    <string name="feature_settings_delete_body">Your account, your sources and their credentials, the imported catalogues, your favourites, your list, your progress and your devices will be deleted right away. This cannot be undone. Your other devices will be signed out.</string>
    <string name="feature_settings_delete_password">Account password</string>
    <string name="feature_settings_delete_confirm">Delete permanently</string>
    <string name="feature_settings_delete_wrong_password">Incorrect password. Nothing was deleted.</string>
    <string name="feature_settings_delete_rate_limited">Too many attempts. Wait a minute. Nothing was deleted.</string>
    <string name="feature_settings_delete_offline">The service cannot be reached. Nothing was deleted.</string>
    <string name="feature_settings_delete_failed">The deletion did not go through: your account still exists. You can try again.</string>

    <!-- Help and information (S16B-03): the two public pages Google Play asks for. -->
    <string name="feature_settings_privacy">Privacy policy</string>
    <string name="feature_settings_account_deletion">How to delete your account</string>
    <string name="feature_settings_tv_about_privacy">Privacy policy: %1$s</string>
    <string name="feature_settings_tv_about_deletion">Deleting your account: %1$s</string>
</resources>
