<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required by ExoPlayer's setWakeMode(WAKE_MODE_NETWORK). Without it
         playback stops when the screen turns off, and some TV boxes drop the
         connection at their idle timeout. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

</manifest>
