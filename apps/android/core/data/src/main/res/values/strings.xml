<?xml version="1.0" encoding="utf-8"?>
<!--
  English strings for core:data. The French set lives in values-fr and ships at
  the same time (AGENTS.md §4); lint fails the build on a missing translation.

  A data module carrying wording is the exception, and these are the whole of it:
  the sentences that put words on a **contract enum** — a synchronisation step, an
  ingestion error code — plus the television's "no source" guidance. They were
  written in feature:source and moved down with the home screen (US-017), which
  has to say the same things about the same source. A feature may not import
  another, and two copies of "your credentials were refused" would drift into two
  different explanations of one failure. `SourceWording.kt` maps the enums.
-->
<resources>
    <!--
      The phases the server actually distinguishes. A named step says two things
      a spinner cannot: that it is moving, and how far it got if it stops.
    -->
    <string name="core_data_sync_step_pending">Starting…</string>
    <string name="core_data_sync_step_connecting">Connecting to your server…</string>
    <string name="core_data_sync_step_authenticated">Signed in. Reading the catalogue…</string>
    <string name="core_data_sync_step_parsing">Reading the channels…</string>
    <string name="core_data_sync_step_parsing_vod">Reading the film catalogue…</string>
    <string name="core_data_sync_step_parsing_series">Reading the series list</string>
    <string name="core_data_sync_step_epg">Retrieving the programme guide…</string>

    <!--
      One message per ingestion code, never a generic fallback: the user's next
      action differs completely between "the server is down" and "your password
      is wrong", and the contract says no client may collapse them.
    -->
    <string name="core_data_ingestion_unreachable">The server did not answer. Check the address, or try again shortly.</string>
    <string name="core_data_ingestion_auth_failed">Your credentials were refused by the server.</string>
    <string name="core_data_ingestion_invalid_format">This address does not return a usable playlist.</string>
    <string name="core_data_ingestion_empty">The playlist was read, but it holds no channel.</string>
    <string name="core_data_ingestion_too_large">This playlist is too large to import.</string>
    <string name="core_data_ingestion_max_connections">Your subscription with this provider is already using all the streams it allows. Stop another one, then try again.</string>
    <string name="core_data_ingestion_expired">Your subscription with this provider has expired. Lumo cannot renew it.</string>
    <string name="core_data_ingestion_unexpected">Something went wrong. Please try again.</string>

    <!-- A television never types a source: it says where one is added. -->
    <string name="core_data_source_tv_none_title">No source configured</string>
    <string name="core_data_source_tv_none_body">Add your source from your phone or lumo.tv — it will appear here automatically.</string>

    <!--
      The notice four screens put over their content while the source they
      browse refreshes, or after its last attempt failed (US-024, lot C4): the
      home screen and the three catalogue grids. One wording, here, because a
      feature may not import another. `SourceNotice.kt` maps the states.
    -->
    <string name="core_data_notice_refreshing_title">Your source is being refreshed</string>
    <!-- With a previous catalogue: browsing goes on, playback waits (C4, D2). -->
    <string name="core_data_notice_refreshing_hint">The previous catalogue stays available. Playback resumes when the refresh ends.</string>
    <!-- A first import: there is no previous catalogue to speak of. -->
    <string name="core_data_notice_importing_hint">What is already on this device stays available.</string>
    <string name="core_data_notice_failed_title">Your source has a problem</string>
    <string name="core_data_notice_failed_stale">This catalogue may be out of date.</string>
    <string name="core_data_notice_open_sources">My sources</string>

    <!--
      The server could not be reached and the device browses from its own memory
      (US-024, "Indisponibilité et hors ligne"). Two controls, the two the story
      names; and nothing about the source itself, which an outage proves nothing
      about. "Change source" leads to My sources, where a source is chosen.
    -->
    <string name="core_data_notice_unreached_title">Lumo could not be reached</string>
    <string name="core_data_notice_unreached_message">This catalogue may be out of date.</string>
    <string name="core_data_notice_change_source">Change source</string>

    <!--
      The same outage with nothing to show: no choice on this device, or a choice
      whose catalogue was never cached. Never "no source", and it says so: an
      outage is not a proof of deletion.
    -->
    <string name="core_data_unreached_title">Lumo could not be reached</string>
    <string name="core_data_unreached_body">Your sources could not be fetched, and nothing of this catalogue is stored on this device. Nothing has been removed. Check your connection, then try again — or choose another source.</string>

    <!--
      The first import of a source, on a catalogue screen (US-024, lot C4). The
      only case where a grid is not shown: nothing was ever ingested and nothing
      is cached. Importing and failed used to share one "not ready" sentence; the
      real step, or the reason, is drawn between the title and the body.
    -->
    <string name="core_data_first_import_title">Your source is being imported</string>
    <string name="core_data_first_import_body">Your catalogue appears here as soon as the first import ends. You can leave this screen meanwhile.</string>
    <string name="core_data_first_import_failed_title">The first import failed</string>
    <string name="core_data_first_import_failed_body">Nothing could be imported yet. Open My sources to see what to correct and to try again.</string>

    <!--
      A section whose request failed with nothing cached. Never presented as an
      empty one: "no films" would be a statement about the source made from a
      request that did not reach it.
    -->
    <string name="core_data_catalogue_unavailable_title">This section could not be loaded</string>
    <string name="core_data_catalogue_unavailable_body">It may not be empty: the request failed. Check your connection, then try again.</string>
    <string name="core_data_catalogue_retry">Try again</string>

    <!--
      A source deleted from another device while something plays (US-024). The
      three players say it in the same words; the server has confirmed it by the
      time this is shown, never a network error.
    -->
    <string name="core_data_source_deleted_message">This source has been removed from your account.</string>
    <string name="core_data_source_deleted_continue">Continue</string>
</resources>
