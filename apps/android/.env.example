# ==============================================================================
# iptv-lumo / iptv-lumo-tv (apps/android) — environment template.
#
#   cp apps/android/.env.example apps/android/.env
#
# Read by the Gradle build and surfaced through BuildConfig / a version catalog.
# .env is gitignored (AGENTS.md §5). Signing material and Google service files
# are gitignored repository-wide and are never committed, in any branch.
#
# One Gradle project produces two applications (ADR 0004):
#   tv.lumo.android    - phone and tablet
#   tv.lumo.androidtv  - Android TV
# Everything below the UI layer is shared, so both read the same values here.
# ==============================================================================

# ---- API ---------------------------------------------------------------------

# Base URL of lumo-api for a DEBUG build running on a physical device on your
# local network. Replace with your machine's LAN address.
LUMO_API_BASE_URL_DEBUG=http://10.0.2.2:8080/v1

# 10.0.2.2 is the loopback alias the Android EMULATOR uses to reach the host
# machine. `localhost` inside the emulator is the emulator itself, which is the
# single most common cause of "the app cannot reach my API" during setup
# (docs/architecture.md §7).
LUMO_API_BASE_URL_EMULATOR=http://10.0.2.2:8080/v1

# Base URL for release builds.
LUMO_API_BASE_URL_RELEASE=https://api.lumo.tv/v1

# Seconds before an API call is abandoned. This is the call to LUMO'S API only.
# Stream playback goes directly to the user's own server and is governed by the
# player, not by this value.
LUMO_API_TIMEOUT_SECONDS=30


# ---- Google Sign-In (US-03) --------------------------------------------------

# The WEB OAuth client ID, not the Android one. Credential Manager requires the
# web client ID as its server client ID, and the backend validates the resulting
# id_token against that same value. Using the Android client ID here produces an
# id_token the backend rejects, with a confusing error.
LUMO_GOOGLE_WEB_CLIENT_ID=


# ---- TV activation (US-05) ---------------------------------------------------

# Page the QR code on the television points at. The full code becomes
# https://lumo.tv/activate?code=XXXXXXXX so the nominal path needs no typing at
# all on the remote control.
LUMO_ACTIVATION_URL=https://lumo.tv/activate


# ---- Signing -----------------------------------------------------------------

# Release signing keystore. Path is relative to apps/android/, or absolute.
# The keystore itself is NEVER committed; on CI these come from encrypted
# secrets. Left empty, release builds fall back to the debug key and are not
# publishable.
LUMO_KEYSTORE_PATH=
LUMO_KEYSTORE_PASSWORD=
LUMO_KEY_ALIAS=
LUMO_KEY_PASSWORD=


# ---- Build -------------------------------------------------------------------

# Enable R8 full mode on release builds.
LUMO_MINIFY_RELEASE=true

# Local Gradle build cache and configuration cache. Purely a developer
# convenience; CI sets its own.
ORG_GRADLE_CACHING=true
ORG_GRADLE_PARALLEL=true


# ---- Test streams ------------------------------------------------------------
#
# NO REAL CHANNEL, LOGO OR STREAM URL BELONGS IN THIS REPOSITORY - fixtures,
# screenshots, database seeds and form defaults included (AGENTS.md §1).
# Manual testing uses rights-free streams only: Big Buck Bunny, the Apple HLS
# test streams, Mux test assets. Left empty on purpose: fill it in locally, and
# do not commit what you fill in.
LUMO_DEV_TEST_STREAM_URL=
