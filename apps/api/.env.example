# ==============================================================================
# lumo-api — environment template.
#
#   cp apps/api/.env.example apps/api/.env
#
# .env is gitignored and must never be committed (AGENTS.md §5). This file is
# the documentation of every variable; keep it in sync when you add one.
#
# The docker-compose stack reads this same file:
#   docker compose --env-file apps/api/.env up -d
# ==============================================================================

# ---- Runtime -----------------------------------------------------------------

# Active Spring profile. `dev` enables verbose startup logging and a permissive
# CORS origin list. Never `dev` in production.
SPRING_PROFILES_ACTIVE=dev

# Port the API listens on, on the host. The container always listens on 8080
# internally; this only remaps the published port.
LUMO_API_PORT=8080


# ---- PostgreSQL 16 (ADR 0002) ------------------------------------------------

# Database, user and password for the local Postgres container. These are
# development values; production credentials come from the deployment platform's
# secret store, never from a file.
POSTGRES_DB=lumo
POSTGRES_USER=lumo
POSTGRES_PASSWORD=change-me-in-your-local-env

# Host port the database is published on. Change it if 5432 is already taken by
# another Postgres on your machine.
POSTGRES_PORT=5432

# JDBC URL used when the API runs natively on the host (outside compose).
# Inside compose the host is the service name `postgres`, and the value is set
# by docker-compose.yml, not by this file.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lumo

# HikariCP pool size. Sized to what the DATABASE can serve, never to the number
# of threads (ADR 0005 §2): virtual threads do not create database capacity, and
# ten thousand of them against a pool of twenty produce acquisition timeouts
# that surface as confusing, unrelated-looking failures.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20

# Milliseconds a caller waits for a connection before failing. Kept low and
# monitored on purpose: a fast, explicit failure is diagnosable, a slow one is not.
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=10000


# ---- Concurrency (ADR 0005) --------------------------------------------------

# Virtual threads. The whole ingestion layer is written in blocking sequential
# style and depends on this being true. Do not disable it.
SPRING_THREADS_VIRTUAL_ENABLED=true

# Maximum simultaneous outbound requests to a SINGLE destination host, enforced
# by a Semaphore per host in ingest/.
#
# This is a product safeguard, not a performance knob. Virtual threads removed
# the implicit ceiling a bounded thread pool used to provide; without this cap,
# a burst of syncs opens hundreds of connections to one user's IPTV panel and
# gets THAT USER's account throttled or banned.
LUMO_INGEST_MAX_CONCURRENT_PER_HOST=4

# Global ceiling on concurrent source synchronisations across all users.
LUMO_INGEST_MAX_CONCURRENT_SYNCS=50

# Seconds before an outbound call to a third-party IPTV server is abandoned.
# Many panels are slow; this is the line between "slow" and "unreachable"
# (SOURCE_UNREACHABLE).
LUMO_INGEST_HTTP_TIMEOUT_SECONDS=10

# Hard ceiling on an ingested payload, in megabytes. Exceeding it is
# SOURCE_TOO_LARGE. Parsing is streamed, never buffered whole, so this bounds
# work rather than memory.
LUMO_INGEST_MAX_PAYLOAD_MB=200


# ---- Security: sessions ------------------------------------------------------

# Signing key for access-token JWTs. At least 32 bytes of real randomness:
#   openssl rand -base64 48
# The API refuses to boot without it. Rotating it invalidates every access token
# in circulation (refresh tokens survive, so clients recover on their next refresh).
LUMO_JWT_SECRET=

# Access-token lifetime in minutes. Short by design: 15 minutes bounds the damage
# of a leaked token, and the refresh rotation makes it invisible to the user.
LUMO_JWT_ACCESS_TTL_MINUTES=15

# Refresh-token lifetime in days. Opaque, stored hashed, rotated on every use.
LUMO_REFRESH_TTL_DAYS=30


# ---- Security: source credential encryption ----------------------------------

# Master key wrapping the per-source data keys used to encrypt Xtream passwords
# (AES-256-GCM). 32 bytes, base64:
#   openssl rand -base64 32
#
# In production this comes from a KMS and is NEVER an environment variable.
# Losing it makes every stored source credential permanently unreadable; leaking
# it exposes every user's IPTV account. Treat it accordingly.
LUMO_ENCRYPTION_MASTER_KEY=


# ---- TV activation, RFC 8628 -------------------------------------------------

# Lifetime of a device authorization, in minutes. Ten is the value the TV
# application and the web activation page both assume.
LUMO_DEVICE_CODE_TTL_MINUTES=10

# Minimum seconds between two polls of /auth/device/token. Returned to the TV as
# `interval`; polling faster earns SLOW_DOWN.
LUMO_DEVICE_CODE_POLL_INTERVAL_SECONDS=5


# ---- Web ---------------------------------------------------------------------

# Public base URL of lumo.tv. Used to build the verification, password-reset and
# device-activation links sent by email or encoded in the TV's QR code.
LUMO_WEB_BASE_URL=http://localhost:3000

# Comma-separated CORS origins allowed to call this API from a browser.
# The Android applications are not browsers and are unaffected by this.
LUMO_CORS_ALLOWED_ORIGINS=http://localhost:3000


# ---- Google Sign-In (US-03) --------------------------------------------------

# OAuth client ID the backend validates incoming Google id_tokens against: the
# `aud` claim must equal this. The server verifies signature, aud, iss and exp
# itself and never trusts an email sent by a client.
LUMO_GOOGLE_CLIENT_ID=


# ---- Email -------------------------------------------------------------------

# SMTP transport for verification and password-reset messages. Point this at a
# local catcher (MailHog, Mailpit) in development; nothing real is ever sent
# from a developer machine.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
LUMO_MAIL_FROM=no-reply@lumo.tv


# ---- Billing: Stripe (ADR 0003) ----------------------------------------------

# Test-mode secret key. v1 sells only from the web; the applications carry no
# purchase flow and read GET /v1/me/entitlement instead.
#
# LEAVING IT EMPTY IS A SUPPORTED STATE, and the normal one on a developer
# machine: the API boots, every other endpoint works, and the two /billing/*
# endpoints answer 503. Nothing else degrades.
STRIPE_SECRET_KEY=

# The recurring price the paid plan buys (`price_...`). Required alongside the
# secret key; either one missing means billing is off.
STRIPE_PRICE_ID=

# Free-trial length in days. 0 disables it. This is what puts an entitlement in
# TRIALING, and it is a server-side number: no client decides how long a trial
# lasts.
STRIPE_TRIAL_DAYS=0

# Overridable so a test can point at a local double. Never point it anywhere but
# Stripe in a real deployment.
STRIPE_API_BASE_URL=https://api.stripe.com

# Signing secret of the webhook endpoint that writes into `entitlement`.
# Every webhook signature is verified: this endpoint is the only writer of a
# user's access rights, so an unverified one is a free premium subscription.
#
# THE WEBHOOK DOES NOT EXIST YET. It is absent from openapi.yaml, and AGENTS.md
# §3 says a need the contract does not cover is escalated rather than invented.
# Until it lands, a completed payment changes nothing: see
# docs/design/api-gaps.md.
STRIPE_WEBHOOK_SECRET=

# Where Stripe returns the browser. Built server-side and resolved against
# LUMO_WEB_BASE_URL — a caller-supplied return URL is an open redirect wearing a
# billing costume.
LUMO_BILLING_SUCCESS_PATH=/app/subscription?checkout=success
LUMO_BILLING_CANCEL_PATH=/app/subscription?checkout=cancelled
LUMO_BILLING_RETURN_PATH=/app/subscription


# ---- Plan limits (ADR 0003) --------------------------------------------------

# What each tier allows. THE ONLY PLACE THESE NUMBERS EXIST in the whole
# product: clients read them off GET /v1/me/entitlement and never carry a copy,
# because a client-side copy is an access right computed client-side. Leave a
# value empty to mean unlimited — which is what PREMIUM does, by having no
# entries at all.
LUMO_PLAN_FREE_MAX_SOURCES=1
LUMO_PLAN_FREE_MAX_DEVICES=2


# ---- Automatic re-synchronisation --------------------------------------------

# What Source.auto_sync actually does. Off, and the property is a switch wired
# to nothing: the contract tells the user the server refreshes their source by
# itself, and the catalogue goes stale anyway.
LUMO_AUTO_SYNC_ENABLED=true

# How often the sweep looks for due sources, and how stale a catalogue must be
# before it is refreshed.
LUMO_AUTO_SYNC_SWEEP_INTERVAL=PT1H
LUMO_AUTO_SYNC_EVERY_HOURS=12

# How many sources one sweep may start. The bound that keeps "we refresh it for
# you" from becoming a thousand simultaneous connections to a thousand of the
# users' own panels. LUMO_INGEST_MAX_CONCURRENT_PER_HOST still applies on top.
LUMO_AUTO_SYNC_BATCH_SIZE=25


# ---- Observability -----------------------------------------------------------

# Root log level. Whatever you set here, no stream URL, Xtream password or token
# is ever written to a log, at any level, DEBUG included (AGENTS.md §5).
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_TV_LUMO=DEBUG

# Actuator exposure. `health` only, in every environment.
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health

# How much of the health report is returned. `when_authorized` shows components
# - the database, the connection pool - only to an authenticated caller;
# `never` is the safe default for a probe reachable from outside. `always`
# publishes your datasource URL to anyone who asks, so keep it out of anything
# facing a network you do not own.
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when_authorized


# ---- Schema migrations (ADR 0006) --------------------------------------------

# Liquibase runs at startup and owns the schema. There is no ORM to fall back
# on: persistence is JdbcClient over hand-written SQL against tables this
# creates, so an application started with it off talks to whatever schema
# happens to be there. It exists as a variable for exactly one case - a second
# instance rolling out while the first has already migrated - and `false`
# outside that case is a way to spend an afternoon on a missing-column error.
SPRING_LIQUIBASE_ENABLED=true
